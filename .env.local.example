# Copy this file to .env.local and fill in the values from your Supabase
# project settings: Project Settings → API.
#
# NEXT_PUBLIC_* variables are exposed to the browser — never put a secret
# in one of them. Only the anon/publishable key belongs here.

# Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" / "publishable" key (Project Settings → API → Project API keys).
# Newer Supabase projects label this key "publishable" (sb_publishable_...);
# older projects label the same key "anon public" (a long JWT). Either one
# goes here — they play the exact same role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Secret "service_role" key (Project Settings → API → Project API keys).
# Server-only. NEVER prefix this with NEXT_PUBLIC_, never expose it to the
# browser, never commit it. Used exclusively in Server Actions to invite,
# update and delete users through the Supabase Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build the redirect links inside invitation and
# password-reset e-mails. Optional locally (falls back to the request's
# Host header) — set it explicitly in Vercel to your production domain.
# NEXT_PUBLIC_SITE_URL=https://preox.example.com

# Required by the "À table" module: symmetric key used to encrypt each
# user's own Gemini/Pexels API keys at rest (AES-256-GCM). Server-only.
# Generate with: openssl rand -base64 32
A_TABLE_ENCRYPTION_KEY=your-32-byte-base64-key

# Required by the "El Profesor" module: a single Gemini API key used
# server-side for the admin-triggered chapter extraction pipeline (unlike
# "À table", this isn't per-user — importing a chapter is an admin action
# on the shared library, so one hub-wide key is enough). Get a key at
# https://aistudio.google.com/apikey. Server-only, never exposed to the browser.
EL_PROFESOR_GEMINI_API_KEY=your-gemini-api-key
